{
  "name": "coltivio-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "cudba",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/agricoltivio/coltivio-api.git"
  },
  "scripts": {
    "compile": "tsc && yarn sentry:sourcemaps",
    "start": "ts-node src/index.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "jest -i",
    "stripe:dev": "stripe listen --forward-to localhost:8000/v1/webhooks/stripe",
    "generate:api-types": "ts-node ./scripts/generate-openapi-docs.ts",
    "db:reset": "supabase db reset --no-seed && psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -f scripts/setup-test-db.sql && yarn db:migrate && node scripts/seed-auth.mjs",
    "db:seed": "ts-node ./src/db/seed.ts",
    "db:push": "npx drizzle-kit push",
    "db:generate": "yarn drizzle-kit generate",
    "db:migrate": "yarn drizzle-kit migrate",
    "db:backup": "supabase db dump --data-only --exclude=public.federal_farm_plots -f backup_data_$(date +%Y%m%d).sql",
    "db:backup:prod": "bash scripts/backup-prod-db.sh",
    "fix": "ts-node ./to_geojson.ts",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org agricoltivio --project node-express ./dist && sentry-cli sourcemaps upload --org agricoltivio --project node-express ./dist",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || ^26.0.0"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@mapbox/geojson-area": "^0.2.2",
    "@nbelyh/exceljs": "^4.3.2",
    "@sentry/cli": "^3.7.0",
    "@sentry/node": "^10.73.0",
    "@supabase/supabase-js": "^2.115.0",
    "axios": "^1.20.0",
    "compression": "^1.8.0",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "drizzle-zod": "^0.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-zod-api": "^29.5.2",
    "http-errors": "^2.0.0",
    "i18next": "^26.4.2",
    "i18next-http-middleware": "^3.9.8",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "polylabel": "^2.1.0",
    "postgres": "^3.4.9",
    "shpjs": "^6.1.0",
    "stripe": "^22.6.1",
    "supabase": "^2.116.0",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.4",
    "@types/jszip": "^3.4.1",
    "@types/lodash": "^4.17.25",
    "@types/mapbox__geojson-area": "^0.2.6",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/polylabel": "^2.0.0",
    "@types/shpjs": "^3.4.7",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "^10.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globalSetup": "./src/test/globalSetup.ts",
    "globalTeardown": "./src/test/globalTeardown.ts",
    "setupFiles": [
      "./src/test/setup.ts"
    ]
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
